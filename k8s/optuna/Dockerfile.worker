# Optuna worker image: shared base + the file-config worker script +
# its shared helpers (MODELS map + config) + the baked-in working parquet.
# The image MIRRORS the repo layout so every __file__-relative path
# (03_optuna_worker.py, _common.py, project.working) resolves in the pod
# exactly as it does locally — the repo layout is the single source of truth.
FROM broadway-base:latest
COPY project/experiments/mlflow/03_optuna_worker.py /app/project/experiments/mlflow/03_optuna_worker.py
COPY project/experiments/mlflow/_common.py /app/project/experiments/mlflow/_common.py
COPY project/config/experiments/mlflow.yaml /app/project/config/experiments/mlflow.yaml
COPY project/config/experiments/working.yaml /app/project/config/experiments/working.yaml
COPY project/experiments/results/univariate/sample_evidence/sample_evidence.parquet \
     /app/project/experiments/results/univariate/sample_evidence/sample_evidence.parquet
# Base image sets PYTHONPATH=/app/src (for broadway.*); the worker ALSO needs
# the repo root on the path so `project.*` and the baked _common.py resolve.
ENV PYTHONPATH="/app/src:/app"
CMD ["python", "/app/project/experiments/mlflow/03_optuna_worker.py"]

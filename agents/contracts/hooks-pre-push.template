#!/bin/sh
# hooks-pre-push.template — SSOT for this repository's pre-push hook contract.
#
# Class declaration: L1 LOCAL GUARD. Contract: a push is admitted only if
# BOTH local gates pass first (exit non-zero exactly when either does):
#   1. FAST-TIER local CI — scripts/run_local_ci.sh --tier=fast (<90s by
#      design; the FULL tier runs in GitHub CI, never in the push path —
#      running full locally timed out pushes and blocked landing).
#   2. TIER-GATE (D34/D35) — the exact unpushed batch piped through
#      tg_run from scripts/tier_gate.sh: every gated commit carries a
#      computed 'Tier:' trailer (FULL|FAST|STATIC|DOCS). Same grammar as
#      scripts/ship.sh — one law, two doors; a raw 'git push' cannot
#      bypass what ship.sh checks. (The previous Gate 2 called a symbol
#      that never existed in tier_gate.sh and failed every push closed —
#      replaced 2026-09-19; the Tier: trailer law IS the batch law.)
#
# Installation is a DOCUMENTED MANUAL STEP by design: core.hooksPath is
# machine-local, and L1's remedy is VERIFICATION (scripts/ship.sh refuses to
# push when this hook is missing or stale), never auto-install. At repo root:
#   cp agents/contracts/hooks-pre-push.template .git/hooks/pre-push
#   chmod +x .git/hooks/pre-push
#
# Provenance: D34 teeth ① (TIER-GATE packet) + Scout-4 L1 finding, 2026-08-25;
# TIER-GATE rider 2026-09-19 (fast-tier Gate 1; Gate 2 = tg_run Tier: law —
# replaces a Gate 2 that invoked a symbol missing from tier_gate.sh and
# therefore failed every push closed).

set -eu

# --- Gate 1: fast-tier local CI -------------------------------------------
bash scripts/run_local_ci.sh --tier=fast || {
  echo "PRE-PUSH REFUSED: LOCAL-CI RED. No push was attempted." >&2
  exit 1
}

# --- Gate 2: TIER-GATE on the exact unpushed batch -------------------------
# stdin carries the pre-push protocol lines: "<local ref> <local sha> <remote
# ref> <remote sha>". Gate each pushed ref's unpushed range with the same
# tg_run grammar scripts/ship.sh uses.
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_ref" ] || continue
  case "$remote_ref" in
    refs/heads/*) ;;      # branch push — gate it
    *) continue ;;       # tag or other ref — not covered by this law
  esac

  # Null remote sha = branch creation: no baseline, law starts with the
  # branch's second push (mirrors ship.sh's no-baseline skip).
  [ "$remote_sha" = "0000000000000000000000000000000000000000" ] && continue

  # shellcheck source=scripts/tier_gate.sh
  . scripts/tier_gate.sh

  if ! git rev-list "$remote_sha..$local_sha" | tg_run; then
    echo "PRE-PUSH REFUSED: TIER-GATE rejected the batch for $remote_ref." >&2
    echo "  Every pushed commit needs a 'Tier:' trailer (FULL|FAST|STATIC|DOCS)." >&2
    exit 1
  fi
done
exit 0

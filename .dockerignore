# Docker build context exclusions — keep the worker image lean.
# .env + deepseek-harness/ hold live credentials/harness material — never
# stream them into a build context (Scout-1 F4, 2026-08-25).
.env
deepseek-harness/
artifacts/
.git
.venv
__pycache__
*.pyc
data/
mlruns/
node_modules/
.mplconfig/
.pytest_cache/
diagnostics_experiment/
legend_experiment/
experiments/results/*
!experiments/results/univariate/
!experiments/results/univariate/sample_evidence/
!experiments/results/univariate/sample_evidence/sample_evidence.parquet
!experiments/results/univariate/sample_evidence/sample_evidence.json
